# Repo-wide rules. frontend/.gitignore and backend/.gitignore add app-specific ones.

# Secrets and environment files (any folder). Commit only *.example templates.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
secrets/
credentials*.json
service-account*.json

# Python virtual environments and caches (any folder)
venv/
.venv/
env/
__pycache__/
*.py[cod]

# Node (any folder)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs and local databases
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Editors and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
